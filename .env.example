# FitFlow Pro — environment configuration example.
# Copy to .env and fill in your own values. Never commit a real .env file.

APP_NAME="FitFlow Pro"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/fitflow-pro-saas/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitflow_pro
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

MAIL_FROM=no-reply@example.com
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=

# Payment gateway (optional — manual payment recording works without it)
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
